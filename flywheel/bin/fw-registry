#!/usr/bin/env python3
"""Event-sourced registry of resources the flywheel created."""
from __future__ import annotations

import argparse
import json
import secrets
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fwlib  # noqa: E402

KINDS = ["worktree", "branch", "dir", "pid", "run-dir"]
CONTAINER_KINDS = ("worktree", "dir", "run-dir")


class Usage(Exception):
    pass


class Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(f"{self.prog}: error: {message}", file=sys.stderr)
        sys.exit(1)


def resolve(p: str) -> str:
    return str(Path(p).expanduser().resolve())


def pid_start(pid: int) -> str | None:
    try:
        r = fwlib.run(["ps", "-o", "lstart=", "-p", str(pid)], timeout=10)
    except Exception:
        return None
    out = r.stdout.strip()
    return out if r.returncode == 0 and out else None


def parse_meta(s: str | None) -> dict:
    if s is None:
        return {}
    try:
        m = json.loads(s)
    except json.JSONDecodeError as e:
        raise Usage(f"--meta is not valid JSON: {e}")
    if not isinstance(m, dict):
        raise Usage("--meta must be a JSON object")
    return m


def states() -> dict[str, dict]:
    out: dict[str, dict] = {}
    for ev in fwlib.read_jsonl_objects(fwlib.registry_path(), ("id",)):
        kind = ev.get("event")
        rid = ev.get("id")
        if not rid:
            continue
        if kind == "add":
            st = {k: v for k, v in ev.items() if k != "event"}
            st["meta"] = dict(ev.get("meta") or {})
            st["status"] = "active"
            out[rid] = st
        elif rid in out:
            if kind == "update":
                out[rid]["meta"].update(ev.get("meta") or {})
            elif kind == "remove":
                out[rid]["status"] = "removed"
                out[rid]["removed_ts"] = ev.get("ts")
                out[rid]["reason"] = ev.get("reason")
    return out


def cmd_add(a) -> int:
    meta = parse_meta(a.meta)
    path = pid = start = None
    if a.kind == "pid":
        if a.pid is None:
            raise Usage("--kind pid requires --pid")
    elif a.path is None:
        raise Usage(f"--kind {a.kind} requires --path")
    if a.path is not None:
        path = resolve(a.path)
    if a.pid is not None:
        pid = a.pid
        start = pid_start(pid)
        if start is None:
            raise Usage(f"process {pid} does not exist")
    rec = {
        "event": "add",
        "id": f"{a.kind}-{secrets.token_hex(4)}",
        "ts": fwlib.iso(),
        "kind": a.kind,
        "path": path,
        "pid": pid,
        "pid_start": start,
        "repo": a.repo,
        "run": a.run,
        "wp": a.wp,
        "purpose": a.purpose,
        "meta": meta,
    }
    fwlib.append_jsonl(fwlib.registry_path(), rec)
    fwlib.emit(rec)
    return 0


def cmd_remove(a) -> int:
    if a.id is None and a.path is None and a.pid is None:
        raise Usage("one of --id, --path, --pid is required")
    want_path = resolve(a.path) if a.path is not None else None
    ids = []
    with fwlib.locked(fwlib.registry_path()):
        for rid, st in states().items():
            if st["status"] != "active":
                continue
            if (a.id is not None and rid == a.id) or \
               (want_path is not None and st.get("path") == want_path) or \
               (a.pid is not None and st.get("pid") == a.pid):
                ids.append(rid)
        if not ids:
            print("no matching active resource", file=sys.stderr)
            return 1
        for rid in ids:
            line = {"event": "remove", "id": rid, "ts": fwlib.iso(), "reason": a.reason}
            with open(fwlib.registry_path(), "a", encoding="utf-8") as fh:
                fh.write(json.dumps(line, sort_keys=True) + "\n")
    fwlib.emit(ids)
    return 0


def cmd_update(a) -> int:
    meta = parse_meta(a.meta)
    with fwlib.locked(fwlib.registry_path()):
        if a.id not in states():
            print(f"unknown id {a.id}", file=sys.stderr)
            return 1
        with open(fwlib.registry_path(), "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"event": "update", "id": a.id, "ts": fwlib.iso(), "meta": meta}, sort_keys=True) + "\n")
    return 0


def cmd_list(a) -> int:
    out = []
    for st in states().values():
        if a.status != "all" and st["status"] != a.status:
            continue
        if a.kind and st.get("kind") != a.kind:
            continue
        if a.run and st.get("run") != a.run:
            continue
        if a.repo and st.get("repo") != a.repo:
            continue
        out.append(st)
    fwlib.emit(out)
    return 0


def cmd_owns(a) -> int:
    target = Path(resolve(a.path))
    for st in states().values():
        if st["status"] != "active" or not st.get("path"):
            continue
        p = Path(st["path"])
        if target == p or (st["kind"] in CONTAINER_KINDS and p in target.parents):
            fwlib.emit(st)
            return 0
    print("null")
    return 1


def main() -> int:
    ap = Parser(prog="fw-registry")
    sub = ap.add_subparsers(dest="cmd", required=True, parser_class=Parser)
    p = sub.add_parser("add")
    p.add_argument("--kind", required=True, choices=KINDS)
    p.add_argument("--path")
    p.add_argument("--pid", type=int)
    p.add_argument("--repo")
    p.add_argument("--run")
    p.add_argument("--wp")
    p.add_argument("--purpose")
    p.add_argument("--meta")
    p.set_defaults(fn=cmd_add)
    p = sub.add_parser("remove")
    p.add_argument("--id")
    p.add_argument("--path")
    p.add_argument("--pid", type=int)
    p.add_argument("--reason")
    p.set_defaults(fn=cmd_remove)
    p = sub.add_parser("update")
    p.add_argument("--id", required=True)
    p.add_argument("--meta", required=True)
    p.set_defaults(fn=cmd_update)
    p = sub.add_parser("list")
    p.add_argument("--kind", choices=KINDS)
    p.add_argument("--run")
    p.add_argument("--repo")
    p.add_argument("--status", choices=["active", "removed", "all"], default="active")
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("owns")
    p.add_argument("path")
    p.set_defaults(fn=cmd_owns)
    a = ap.parse_args()
    try:
        return a.fn(a)
    except Usage as e:
        print(f"fw-registry: {e}", file=sys.stderr)
        return 1
    except Exception as e:  # noqa: BLE001
        print(f"fw-registry: internal error: {e!r}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
