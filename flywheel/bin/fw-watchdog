#!/usr/bin/env python3
"""Watchdog run by launchd every 10 min: finish stopped runs, wake a stopped or stalled orchestrator, housekeep."""
from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import json
import sys
import traceback
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fwlib  # noqa: E402
import fwrun  # noqa: E402

FULL_HOUSEKEEP_EVERY = dt.timedelta(hours=24)
STOP_OVERRUN_S = 30 * 60
STOP_IDLE_S = 2 * 60
IDLE_STALE_S = 45 * 60
BUSY_STALE_S = 3 * 3600
BLOCKED_STALE_S = 8 * 60
MAX_HOUSEKEEP_ERRORS = 5


class Watchdog:
    def __init__(self, dry_run: bool):
        self.dry_run = dry_run
        self.actions: list[dict] = []

    def log(self, action: str, detail: str = "") -> None:
        self.actions.append({"action": action, "detail": detail})
        line = f"{fwlib.iso(fwrun.now())} {action} {detail}".rstrip() + "\n"
        try:
            with open(fwlib.state_dir() / "watchdog.log", "a", encoding="utf-8") as fh:
                fh.write(line)
        except OSError:
            pass

    def housekeep(self, mode: str, profile: str | None = None) -> None:
        args = [f"--{mode}"] + (["--profile", profile] if profile else [])
        if self.dry_run:
            self.log("would-housekeep", " ".join(args))
            return
        r = fwrun.sibling("fw-housekeep", args, timeout=900, log=self.log)
        if r is None:
            return
        self.log("housekeep", f"{' '.join(args)} rc={r.returncode}")
        try:
            errors = json.loads(r.stdout).get("errors") or []
        except (ValueError, AttributeError):
            errors = [f"rc={r.returncode} {fwrun.tail(r.stderr, 200)}"] if r.returncode else []
        for e in errors[:MAX_HOUSEKEEP_ERRORS]:
            self.log("housekeep-error", fwrun.tail(str(e), 200))

    def set_stopped(self, a: dict) -> None:
        if self.dry_run:
            self.log("would-set-stopped", a["run_id"])
            return
        if fwrun.update_active(a["run_id"], state="stopped") is None:
            self.log("set-stopped-skipped", f"{a['run_id']} is no longer the active run")
            return
        self.log("set-stopped", a["run_id"])

    def stop_reason(self, rd: Path, text: str) -> None:
        if (rd / "stop-reason").exists():
            return
        if self.dry_run:
            self.log("would-stop-reason", text)
            return
        fwrun.write_stop_reason(rd, text)
        self.log("stop-reason", text)

    def claude_stop(self, bg: str | None) -> None:
        if not bg:
            return
        if self.dry_run:
            self.log("would-claude-stop", bg)
            return
        r = fwrun.claude_stop(bg)
        self.log("claude-stop", f"{bg} rc={None if r is None else r.returncode}")

    def hard_stop(self, a: dict, row: dict | None, rd: Path, why: str) -> bool:
        """Stop the session and end the run under the active.json lock; False when the run changed meanwhile."""
        if self.dry_run:
            if fwrun.is_live(row):
                self.claude_stop(fwrun.bg_id_of(a, row))
            self.stop_reason(rd, why)
            self.set_stopped(a)
            return True
        with fwlib.locked(fwlib.active_path()):
            cur = fwrun.read_active_raw()
            if cur is None or cur.get("run_id") != a["run_id"] or cur.get("session_id") != a.get("session_id") \
                    or cur.get("state") not in ("running", "stopping"):
                self.log("hard-stop-aborted", "active run changed during the tick")
                return False
            if fwrun.is_live(row):
                self.claude_stop(fwrun.bg_id_of(cur, row))
            self.stop_reason(rd, why)
            fwrun.update_active_unlocked(a["run_id"], state="stopped")
        self.log("set-stopped", a["run_id"])
        return True

    def list_agents(self) -> tuple[list[dict] | None, str]:
        rows, cause = fwrun.agents_result(timeout=30)
        if rows is not None:
            return rows, ""
        self.log("agents-retry", cause)
        rows, again = fwrun.agents_result(timeout=30)
        return rows, f"cause={cause}, retry={again}"

    def ensure_caffeinate(self, run_id: str, deadline: dt.datetime | None, grace: int) -> None:
        alive = fwrun.caffeinate_alive(run_id, self.log)
        if alive is None or alive:
            return
        if self.dry_run:
            self.log("would-caffeinate", run_id)
            return
        fwrun.start_caffeinate(run_id, deadline, grace, self.log)

    def no_run(self) -> None:
        a = fwrun.read_active_raw()
        fwrun.mark_owner_done(self.log, active_run=None, dry_run=self.dry_run)
        stamp = fwlib.state_dir() / "last-full-housekeep"
        age = fwrun.mtime_age(stamp)
        if age is None or age > FULL_HOUSEKEEP_EVERY.total_seconds():
            self.housekeep("full")
            if not self.dry_run:
                fwrun.touch(stamp)
        else:
            self.housekeep("quick")
        self.log("no-active-run", (a or {}).get("run_id") or "")

    def launch_check(self, snap: dict) -> None:
        """Run in `starting` state: wait for `fw start` to release the lock; end a launch stuck past LAUNCH_STALE_S."""
        run_id = snap["run_id"]
        rd = fwlib.run_dir(run_id)
        stopped = False
        with contextlib.nullcontext() if self.dry_run else fwlib.locked(fwlib.active_path()):
            cur = fwrun.read_active_raw()
            if cur is None or cur.get("run_id") != run_id or cur.get("state") != "starting":
                self.log("launch-finished", f"{run_id} state={(cur or {}).get('state')}; skipping this tick")
                return
            started = fwlib.parse_iso(cur.get("started"))
            age = None if started is None else (fwrun.now() - started).total_seconds()
            if age is not None and age <= fwrun.LAUNCH_STALE_S:
                self.log("launch-pending", f"{run_id} starting for {int(age)}s")
                return
            rows, cause = self.list_agents()
            if rows is None:
                self.log("agents-failed", f"stale launch; session state unknown; no action; {cause}")
                return
            row = fwrun.find_row(rows, cur.get("session_id"))
            self.log("launch-stale", f"{run_id} starting for {'unknown' if age is None else int(age)}s "
                                     f"status={(row or {}).get('status')}")
            if fwrun.is_live(row):
                self.claude_stop(fwrun.bg_id_of(cur, row))
            if self.dry_run:
                self.log("would-stop-reason", "launch-stale")
                self.log("would-set-stopped", run_id)
            else:
                fwrun.write_stop_reason(rd, "launch-stale", overwrite=True)
                self.log("stop-reason", "launch-stale")
                fwrun.update_active_unlocked(run_id, state="stopped")
                stopped = True
        if stopped:
            self.log("set-stopped", run_id)
        fwrun.mark_owner_done(self.log, run_id=run_id, dry_run=self.dry_run)
        self.housekeep("quick", snap.get("profile"))

    def tick(self) -> None:
        raw = fwrun.read_active_raw()
        if raw is not None and raw.get("state") == "starting" and raw.get("run_id"):
            self.launch_check(raw)
            return
        a = fwlib.active()
        if a is None:
            self.no_run()
            return
        run_id = a["run_id"]
        profile = a.get("profile")
        rd = fwlib.run_dir(run_id)
        t = fwrun.now()

        rows, cause = self.list_agents()
        if rows is None:
            self.log("agents-failed", f"session state unknown; no action; {cause}")
            self.housekeep("quick", profile)
            return
        row = fwrun.find_row(rows, a.get("session_id"))
        live = fwrun.is_live(row)
        bg = fwrun.bg_id_of(a, row)
        status = (row or {}).get("status")
        self.log("session", f"{run_id} status={status} state={(row or {}).get('state')} bg={bg}")

        grace = 120
        try:
            grace = int(fwlib.load_profile(profile).get("deadline_grace_min", 120)) if profile else 120
        except Exception:  # noqa: BLE001
            pass
        deadline = fwlib.parse_iso(a.get("deadline"))
        sr = rd / "stop-reason"
        sr_age = fwrun.mtime_age(sr, t)

        hard = None
        if fwlib.kill_path().exists():
            hard = "kill"
        elif deadline is not None and t > deadline + dt.timedelta(minutes=grace):
            hard = "deadline-overrun"
        elif sr_age is not None and live and sr_age > STOP_OVERRUN_S:
            hard = "stop-overrun"
        elif sr_age is not None and status == "idle" and sr_age > STOP_IDLE_S:
            # A background session stays alive after its last turn; once it is idle past stop-reason, it is done.
            hard = "stop-complete"
        if hard:
            self.log("hard-stop", hard)
            if not self.hard_stop(a, row, rd, hard):
                return
            fwrun.mark_owner_done(self.log, run_id=run_id, dry_run=self.dry_run)
            self.housekeep("quick", profile)
            return

        if sr_age is not None:
            if live:
                self.log("stop-pending", f"stop-reason written {int(sr_age)}s ago; session still {status}")
            else:
                self.set_stopped(a)
                fwrun.mark_owner_done(self.log, run_id=run_id, dry_run=self.dry_run)
            self.housekeep("quick", profile)
            return

        budget = fwrun.sibling_json("fw-budget", [], timeout=120, log=self.log)
        weekly = ((budget or {}).get("usage") or {}).get("max_weekly") if isinstance(budget, dict) else None
        if isinstance(weekly, (int, float)) and weekly >= 95:
            self.log("weekly-stop", f"max_weekly={weekly}")
            if not live:
                self.stop_reason(rd, "budget")
                self.set_stopped(a)
            self.housekeep("quick", profile)
            return

        self.ensure_caffeinate(run_id, deadline, grace)

        hb = fwrun.heartbeat_age(a, rd, t)
        reason = None
        if row is None:
            reason = "missing from claude agents"
        elif status is None or row.get("state") in ("failed", "stopped"):
            reason = f"not running (state {row.get('state')})"
        elif fwrun.is_blocked(row):
            seen = fwlib.parse_iso(a.get("blocked_seen"))
            if seen is None:
                self.log("blocked-seen", f"status={status} state={row.get('state')}")
                if not self.dry_run:
                    fwrun.update_active(run_id, blocked_seen=fwlib.iso(t))
            elif (t - seen).total_seconds() >= BLOCKED_STALE_S:
                reason = (f"blocked waiting for input for {int((t - seen).total_seconds() // 60)}+ min and was "
                          "stopped and resumed; agents it was running may have stopped too. Check each one in "
                          "STATUS.md (progress file, task list) before relaunching it, to avoid duplicates")
        elif status == "idle" and (hb is None or hb > IDLE_STALE_S) and not fwrun.waiting_active(rd, t):
            reason = f"idle with a stale heartbeat ({'unknown' if hb is None else int(hb // 60)} min)"
        elif status == "busy" and hb is not None and hb > BUSY_STALE_S:
            last = fwlib.parse_iso(a.get("busy_stale_logged"))
            if last is None or t - last >= dt.timedelta(hours=1):
                self.log("busy-stale", f"heartbeat {int(hb // 60)} min old")
                if not self.dry_run:
                    fwrun.update_active(run_id, busy_stale_logged=fwlib.iso(t))

        if a.get("blocked_seen") and not fwrun.is_blocked(row) and not self.dry_run:
            fwrun.update_active(run_id, blocked_seen=None)
        if reason:
            res = fwrun.wake(a, row, reason, self.log, dry_run=self.dry_run)
            self.actions.append({"action": "wake-result", "detail": json.dumps(res, sort_keys=True)})
        else:
            self.log("ok", f"status={status} heartbeat={None if hb is None else int(hb)}s")
        self.housekeep("quick", profile)


def main() -> int:
    ap = argparse.ArgumentParser(prog="fw-watchdog")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    w = Watchdog(a.dry_run)
    try:
        w.tick()
    except Exception as e:  # noqa: BLE001
        w.log("error", f"{type(e).__name__}: {e} " + " | ".join(traceback.format_exc().splitlines()[-3:]))
    if a.json:
        fwlib.emit({"dry_run": a.dry_run, "actions": w.actions})
    return 0


if __name__ == "__main__":
    sys.exit(main())
